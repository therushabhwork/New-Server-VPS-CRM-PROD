{
  "name": "crm-server",
  "version": "1.0.0",
  "description": "Backend server for CRM",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:prod": "pm2 start server.js --name crm-backend",
    "stop:prod": "pm2 stop crm-backend",
    "restart:prod": "pm2 restart crm-backend",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "doctor": "node scripts/doctor.js",
    "admin:create": "node scripts/createAdmin.js",
    "db:create": "node scripts/createDatabase.js",
    "db:clean-data": "node scripts/cleanDbCollections.js",
    "db:backup": "node scripts/backupDatabase.js",
    "db:restore": "node scripts/restoreDatabase.js",
    "users:seed-crm-image": "node scripts/seedCrmImageUsers.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "expo-server-sdk": "^7.2.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jest-mock": "^30.5.1",
    "mongoose": "^8.24.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "9.0.1",
    "pino": "^8.21.0",
    "pino-http": "^9.0.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.5.4",
    "swagger-ui-express": "^5.0.0",
    "whatsapp-web.js": "^1.34.7",
    "wwebjs-mongo": "^1.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.0.0"
  }
}
